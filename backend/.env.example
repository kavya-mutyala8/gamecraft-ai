ENVIRONMENT=development
# auto = Gemini when GEMINI_API_KEY is set, otherwise offline mock images
AI_PROVIDER=auto
GEMINI_API_KEY=
# Verify these model IDs against your account; preview names change.
THINKING_MODEL=gemini-3.1-pro-preview
FALLBACK_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-3.1-flash-lite-image
DATABASE_URL=sqlite:///./data/gamecraft.db
STORAGE_DIR=./data/storage
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
MAX_PARALLEL_GENERATIONS=3
